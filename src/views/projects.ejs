<%- include('partials/header') %>
    <main>
        <h1>
            <%= title %>
        </h1>
        <section>
            <h2>Here are some upcoming service projects:</h2>
            <ul>
                <% serviceProjects.forEach(project=> { %>
                    <li><strong>
                            <%= project.date.toLocaleDateString('en-US', { year: 'numeric' , month: 'long' ,
                                day: 'numeric' }) %></strong>: <a href="/project/<%= project.project_id %>"><%= project.title %></a> (<a href="/organization/<%= project.organization_id %>"><%= project.organization_name %></a>)
                    </li>
                    <% }); %>
            </ul>
        </section>
        <p><a href="/new-project">Add a New Service Project</a></p>
    </main>
    <%- include('partials/footer') %>