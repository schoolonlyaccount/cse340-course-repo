<%- include('partials/header') %>
    <main>
        <h1>
            <%= title %>
        </h1>
        <section>
            <h2>Here are some service project categories:</h2>
            <ul>
                <% categories.forEach(category=> { %>
                    <li><a href="/category/<%= category.category_id %>">
                            <%= category.name %>
                        </a></li>
                    <% }); %>
            </ul>
        </section>
        <p><a href="/new-category">Add a new category</a></p>
    </main>
    <%- include('partials/footer') %>