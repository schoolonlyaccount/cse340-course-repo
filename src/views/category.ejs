<%- include('partials/header') %>
    <main>
        <h1>
            <%= title %>
        </h1>
        <section>
            <h2>
                <%= categoryDetails.name %>
            </h2>
            <h3>Associated Service Projects:</h3>
            <ul>
                <% serviceProjects.forEach(project=> { %>
                    <li><a href="/project/<%= project.project_id %>">
                            <%= project.title %>
                        </a></li>
                    <% }) %>
            </ul>
        </section>
    </main>
    <%- include('partials/footer') %>