<%- include('partials/header') %>
    <main>
        <h1>
            <%= title %>
        </h1>
        <section>
            <h2>
                <%= projectDetails.title %>
            </h2>

            <p>Description: <%= projectDetails.description %>
            </p>

            <p>
                Date: <%= projectDetails.date.toLocaleDateString('en-US', { year: 'numeric' , month: 'long' ,
                    day: 'numeric' }) %>
            </p>

            <p>
                Location: <%= projectDetails.location %>
            </p>

            <p>Organization: <a href="/organization/<%= projectDetails.organization_id %>">
                    <%= projectDetails.organization_name %>
                </a></p>
            
            <% if (user && user.role_name === 'admin') { %>
                <p><a href="/edit-project/<%= projectDetails.project_id %>">Edit Service Project</a></p>
            <% } %>

            <h3>Associated Categories:</h3>
            <ul>
                <% categories.forEach(category=> { %>
                    <li><a href="/category/<%= category.category_id %>">
                            <%= category.name %>
                        </a></li>
                    <% }) %>
            </ul>
        </section>

        <% if (isLoggedIn) { %>
            <% if (isVolunteer) { %>
                <p>You are volunteering for this project.</p>
                <form class="volunteer" action="/project/<%= projectDetails.project_id %>/unvolunteer" method="POST">
                    <button type="submit">Remove Me as a Volunteer</button>
                </form>
            <% } else { %>
                <form class="volunteer" action="/project/<%= projectDetails.project_id %>/volunteer" method="POST">
                    <button type="submit">Volunteer for This Project</button>
                </form>
            <% } %>
        <% } %>

        <% if (user && user.role_name === 'admin') { %>
            <a href="/assign-categories/<%= projectDetails.project_id %>">Edit Categories</a>
        <% } %>
    </main>
    <%- include('partials/footer') %>